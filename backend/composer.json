{
    "name": "sherpa/import-api",
    "description": "Импорт/Экспорт товаров: API на Slim 4 + Doctrine ORM",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-amqp": "*",
        "ext-fileinfo": "*",
        "ext-pdo_pgsql": "*",
        "ext-zip": "*",
        "doctrine/dbal": "^4.2",
        "doctrine/migrations": "^3.8",
        "doctrine/orm": "^3.3",
        "firebase/php-jwt": "^7.2",
        "openspout/openspout": "^4.28",
        "php-di/php-di": "^7.0",
        "ramsey/uuid": "^4.7",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/amqp-messenger": "^7.1",
        "symfony/cache": "^7.1",
        "symfony/console": "^7.1",
        "symfony/event-dispatcher": "^7.1",
        "symfony/http-client": "^7.1",
        "symfony/messenger": "^7.1",
        "symfony/rate-limiter": "^7.1"
    },
    "require-dev": {
        "doctrine/data-fixtures": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.0"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs:fix": "php-cs-fixer fix --using-cache=no"
    }
}
