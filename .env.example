# --- Приложение ---
APP_ENV=dev                      # dev | test | prod
APP_DEBUG=1                      # 1 — подробные ошибки в JSON
APP_TARGET=dev                   # stage Dockerfile: dev (с dev-зависимостями) | prod
NGINX_PORT=8080                  # порт приложения на хосте
# DNS-сервер для исходящих запросов контейнеров app/worker (скачивание картинок).
# По умолчанию 1.1.1.1; если сеть блокирует публичный UDP/53 — укажите ваш
# локальный резолвер, напр. DOCKER_DNS=192.168.1.1
# DOCKER_DNS=192.168.2.1

# --- БД (используется и контейнером postgres, и приложением) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app_secret
DB_NAME_TEST=app_test            # БД для PHPUnit

# --- RabbitMQ / Messenger ---
RABBITMQ_USER=app
RABBITMQ_PASSWORD=app_secret
MESSENGER_TRANSPORT_DSN=amqp://app:app_secret@rabbitmq:5672/%2f/messages

# --- Аутентификация ---
JWT_SECRET=change_me_to_random_string_at_least_32_chars
JWT_TTL=3600                     # срок жизни токена, сек
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123          # только для демо; в prod — секрет

# --- Импорт ---
IMPORT_MAX_FILE_SIZE=10485760    # байт (10 МБ)
IMPORT_RATE_LIMIT=5              # кол-во импортов
IMPORT_RATE_INTERVAL="1 minute"  # окно для лимита
IMAGE_DOWNLOAD_TIMEOUT=10        # сек на одну картинку
IMAGE_MAX_SIZE=5242880           # байт (5 МБ) на одну картинку
IMAGE_CONCURRENCY=8              # параллельных загрузок
STORAGE_PATH=/var/www/storage
